{
  "statusline-tracker": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "~/.gemini/config/scripts/track_turn.sh pre_invocation"
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "~/.gemini/config/scripts/track_turn.sh post_invocation"
      }
    ],
    "PreToolUse": [
      {
        "matcher": "ask_question",
        "hooks": [
          {
            "type": "command",
            "command": "~/.gemini/config/scripts/track_turn.sh pre_ask"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "ask_question",
        "hooks": [
          {
            "type": "command",
            "command": "~/.gemini/config/scripts/track_turn.sh post_ask"
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "~/.gemini/config/scripts/track_turn.sh stop"
      }
    ]
  },
  "compact-threshold-tracker": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 ~/.gemini/config/scripts/compact_threshold_tracker.py",
        "timeout": 10
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "python3 ~/.gemini/config/scripts/compact_threshold_tracker.py",
        "timeout": 10
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 ~/.gemini/config/scripts/compact_threshold_tracker.py",
        "timeout": 10
      }
    ]
  },
  "worktree-isolation-guard": {
    "PreToolUse": [
      {
        "matcher": "read_file|edit_file|write_file|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.gemini/config/scripts/worktree_isolation_guard.py pre",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "read_file|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.gemini/config/scripts/worktree_isolation_guard.py post",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "read-file-widener": {
    "PreToolUse": [
      {
        "matcher": "read_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.gemini/config/scripts/read_file_widener.py",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "rtk-rewrite": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.gemini/config/scripts/rtk_rewrite_hook.py",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "context-budget-guard": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 ~/.gemini/config/scripts/context_budget_guard.py",
        "timeout": 10
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "python3 ~/.gemini/config/scripts/context_budget_guard.py post_invocation",
        "timeout": 10
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 ~/.gemini/config/scripts/context_budget_guard.py stop",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": "read_file|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.gemini/config/scripts/context_budget_guard.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "critical-instructions": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "~/.gemini/config/scripts/critical_instructions.sh",
        "timeout": 15
      }
    ]
  },
  "task-schedule-guard": {
    "PreToolUse": [
      {
        "matcher": "manage_task|schedule",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.gemini/config/scripts/conditional_tool_guard.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "skill-usage-tracker": {
    "PostToolUse": [
      {
        "matcher": "read_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.gemini/config/scripts/skill_usage_tracker.py",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "decision-harvester": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 ~/.gemini/config/scripts/decision_harvester_hook.py",
        "timeout": 10
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write_file|edit_file|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.gemini/config/scripts/decision_harvester_hook.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
