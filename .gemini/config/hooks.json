{
  "statusline-tracker": {
    "PostInvocation": [
      {
        "type": "command",
        "command": "~/.gemini/config/scripts/track_turn.sh"
      }
    ]
  },
  "critical-instructions": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "~/.gemini/config/scripts/critical_instructions.sh",
        "timeout": 15
      }
    ]
  },
  "verify-recorder": {
    "PostToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.gemini/config/scripts/verify_recorder.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "verify-failure-guard": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 ~/.gemini/config/scripts/verify_injector.py",
        "timeout": 10
      }
    ]
  }
}
