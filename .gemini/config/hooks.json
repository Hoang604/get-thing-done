{
  "statusline-tracker": {
    "PostInvocation": [
      {
        "type": "command",
        "command": "~/.gemini/config/scripts/track_turn.sh"
      }
    ]
  },
  "critical-instructions": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "~/.gemini/config/scripts/critical_instructions.sh",
        "timeout": 15
      }
    ]
  },
  "task-schedule-guard": {
    "PreToolUse": [
      {
        "matcher": "manage_task|schedule",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.gemini/config/scripts/conditional_tool_guard.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
